    {
      "name": "GET /reviews - reviews by book_id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has reviews array\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"reviews\");",
              "    pm.expect(json.reviews).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"All reviews belong to book_id 1\", function () {",
              "    const reviews = pm.response.json().reviews;",
              "    reviews.forEach(function(review) {",
              "        pm.expect(review.book_id).to.eql(1);",
              "    });",
              "});",
              "",
              "pm.test(\"Each review has required fields\", function () {",
              "    const reviews = pm.response.json().reviews;",
              "    reviews.forEach(function(review) {",
              "        pm.expect(review).to.have.property(\"id\");",
              "        pm.expect(review).to.have.property(\"author_name\");",
              "        pm.expect(review).to.have.property(\"review_text\");",
              "        pm.expect(review).to.have.property(\"recommended\");",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "id": "18cf7daa-fda4-47ec-809f-0f8b00ead7a4"
          }
        }
      ],
