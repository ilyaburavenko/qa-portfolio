            "id": "1a18ab06-4b66-49c3-b12c-f42ce827cb0f",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has review_id\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"review_id\");",
              "    pm.expect(json.review_id).to.be.a(\"number\");",
              "});",
              "",
              "pm.test(\"Response contains correct book_id\", function () {",
              "    pm.expect(pm.response.json().book_id).to.eql(1);",
              "});",
              "",
              "pm.test(\"Response contains correct author_name\", function () {",
              "    pm.expect(pm.response.json().author_name).to.eql(\"Тестировщик\");",
              "});",
              "",
              "pm.test(\"Response contains correct recommended value\", function () {",
              "    pm.expect(pm.response.json().recommended).to.eql(true);",
              "});",
              "",
              "// Сохраняем id созданного отзыва для следующих запросов",
              "pm.collectionVariables.set(\"review_id\", pm.response.json().review_id);",
              "console.log(\"Saved review_id:\", pm.response.json().review_id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
