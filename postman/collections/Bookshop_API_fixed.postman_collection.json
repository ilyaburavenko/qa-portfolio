    {
      "name": "GET /book/{id}",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "a544dde5-2ba1-49eb-bb72-05d961cbdf25",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has all required fields\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json).to.have.property(\"id\");\r",
              "    pm.expect(json).to.have.property(\"title\");\r",
              "    pm.expect(json).to.have.property(\"author\");\r",
              "    pm.expect(json).to.have.property(\"price\");\r",
              "    pm.expect(json).to.have.property(\"description\");\r",
              "    pm.expect(json).to.have.property(\"author_bio\");\r",
              "    pm.expect(json).to.have.property(\"reviews_count\");\r",
              "});\r",
              "\r",
              "pm.test(\"Book id matches requested id\", function () {\r",
              "    pm.expect(pm.response.json().id).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Price is a positive number\", function () {\r",
              "    pm.expect(pm.response.json().price).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Reviews count is a non-negative number\", function () {\r",
              "    pm.expect(pm.response.json().reviews_count).to.be.at.least(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
