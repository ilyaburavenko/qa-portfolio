    {
      "name": "Get\\books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has products array\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"products\");",
              "    pm.expect(pm.response.json().products).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Products array is not empty\", function () {",
              "    pm.expect(pm.response.json().products.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Each product has required fields\", function () {",
              "    pm.response.json().products.forEach(function(p) {",
              "        pm.expect(p).to.have.property(\"id\");",
              "        pm.expect(p).to.have.property(\"title\");",
              "        pm.expect(p).to.have.property(\"author\");",
              "        pm.expect(p).to.have.property(\"price\");",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
